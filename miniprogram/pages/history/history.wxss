/* history.wxss */
.page { height: 100vh; background: #f0f4f0; }

.time-row { display: flex; gap: 14rpx; padding: 22rpx 28rpx 10rpx; }
.time-btn {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx;
  padding: 14rpx 0; border-radius: 14rpx;
  font-size: 26rpx; color: #666; background: #fff; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.t-icon { width: 28rpx; height: 28rpx; }
.t-on { background: #2d8c3f; color: #fff; font-weight: 600; }

.m-row { display: flex; gap: 10rpx; padding: 14rpx 28rpx; flex-wrap: wrap; }
.m-btn {
  display: flex; align-items: center; gap: 8rpx; padding: 10rpx 20rpx;
  border-radius: 22rpx; font-size: 26rpx; color: #666; background: #fff;
  border: 2rpx solid #e0e0e0;
}
.m-icon { width: 28rpx; height: 28rpx; }
.m-on { border-color: #2d8c3f; color: #2d8c3f; background: #e8f5e9; font-weight: 600; }

.chart-box { margin: 14rpx 22rpx; background: #fff; border-radius: 20rpx; padding: 24rpx 20rpx 18rpx; box-shadow: 0 3rpx 12rpx rgba(0,0,0,0.05); }
.chart-head { display: flex; align-items: center; gap: 8rpx; font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 14rpx; }
.ch-icon { width: 32rpx; height: 32rpx; }
.chart-wrap { width: 100%; height: 380rpx; }
.chart-canvas { width: 100%; height: 100%; }

.stat-row { display: flex; justify-content: space-around; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f0f0; }
.stat-it { text-align: center; }
.st-label { display: block; font-size: 22rpx; color: #aaa; }
.st-val { display: block; font-size: 28rpx; font-weight: 700; color: #333; margin-top: 2rpx; }

.sec-title { display: flex; align-items: center; gap: 8rpx; padding: 24rpx 28rpx 10rpx; font-size: 28rpx; font-weight: 600; color: #333; }
.sec-icon { width: 32rpx; height: 32rpx; }
.cnt { font-size: 24rpx; color: #aaa; font-weight: 400; margin-left: 8rpx; }

.relay-box { margin: 0 22rpx; background: #fff; border-radius: 18rpx; padding: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04); }
.rl-item { display: flex; align-items: center; gap: 14rpx; margin-bottom: 16rpx; }
.rl-item:last-child { margin-bottom: 0; }
.rl-icon { width: 32rpx; height: 32rpx; }
.rl-name { font-size: 26rpx; color: #555; width: 56rpx; }
.rl-bar { flex: 1; height: 14rpx; background: #f0f0f0; border-radius: 7rpx; overflow: hidden; }
.rl-fill { height: 100%; border-radius: 7rpx; transition: width 0.4s; }
.rl-pump { background: #1e88e5; }
.rl-light { background: #ffb300; }
.rl-fan { background: #4caf50; }
.rl-pct { font-size: 26rpx; font-weight: 600; color: #333; width: 64rpx; text-align: right; }

.tbl { margin: 0 22rpx; background: #fff; border-radius: 18rpx; overflow: hidden; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04); }
.tbl-hd { display: flex; padding: 14rpx 18rpx; background: #f8f8f8; font-size: 24rpx; font-weight: 600; color: #888; }
.tbl-row { display: flex; padding: 12rpx 18rpx; border-bottom: 1rpx solid #f5f5f5; font-size: 24rpx; color: #444; }
.tbl-row:last-child { border-bottom: none; }
.c1 { flex: 2; }
.c2 { flex: 1; text-align: center; }

.empty { display: flex; flex-direction: column; align-items: center; padding: 60rpx; color: #bbb; font-size: 28rpx; gap: 16rpx; }
.empty-icon { width: 80rpx; height: 80rpx; opacity: 0.4; }
