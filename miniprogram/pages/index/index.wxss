/* index.wxss */
.page { height: 100vh; background: linear-gradient(180deg, #e8f5e9 0%, #f0f4f0 12%); }

.top-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 22rpx 28rpx; margin: 18rpx 22rpx 0;
  background: rgba(255,255,255,0.85); border-radius: 18rpx;
}
.dev-info { display: flex; align-items: center; gap: 10rpx; }
.top-icon { width: 36rpx; height: 36rpx; }
.dev-name { font-size: 28rpx; font-weight: 600; color: #2d8c3f; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.dot-on { background: #4caf50; box-shadow: 0 0 6rpx rgba(76,175,80,0.5); }
.dot-off { background: #f44336; }
.dot-txt { font-size: 24rpx; color: #999; }
.update-time { font-size: 22rpx; color: #bbb; }

.sec-title {
  display: flex; align-items: center; gap: 10rpx;
  padding: 24rpx 28rpx 12rpx; font-size: 28rpx; font-weight: 600; color: #333;
}
.sec-icon { width: 36rpx; height: 36rpx; }

/* 传感器卡片 */
.sensor-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; padding: 0 22rpx; }
.s-card {
  background: #fff; border-radius: 20rpx; padding: 24rpx 20rpx 18rpx;
  box-shadow: 0 3rpx 12rpx rgba(0,0,0,0.05); position: relative; overflow: hidden;
}
.s-card::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 5rpx; }
.s-temp::after { background: #ff5722; }
.s-humi::after { background: #1e88e5; }
.s-lux::after { background: #ffb300; }
.s-water::after { background: #00acc1; }
.s-icon { width: 44rpx; height: 44rpx; display: block; margin-bottom: 6rpx; }
.s-val { display: block; font-size: 42rpx; font-weight: 700; color: #222; line-height: 1.2; }
.s-name { font-size: 24rpx; color: #aaa; }
.s-bar { margin-top: 14rpx; height: 7rpx; background: #f0f0f0; border-radius: 4rpx; }
.s-bar-in { height: 100%; border-radius: 4rpx; transition: width 0.5s; }
.s-bar-temp { background: #ff5722; }
.s-bar-humi { background: #1e88e5; }
.s-bar-lux { background: #ffb300; }
.s-bar-water { background: #00acc1; }

.air-row {
  display: flex; align-items: center; gap: 12rpx;
  margin: 14rpx 22rpx 0; padding: 18rpx 24rpx;
  background: #fff; border-radius: 14rpx; font-size: 28rpx; color: #555;
}
.air-icon { width: 36rpx; height: 36rpx; }

/* 继电器 */
.mode-tag { margin-left: auto; font-size: 22rpx; padding: 5rpx 18rpx; border-radius: 18rpx; }
.m-auto { background: #e8f5e9; color: #2d8c3f; }
.m-manual { background: #fff3e0; color: #e65100; }

.relay-row { display: flex; gap: 14rpx; padding: 0 22rpx; }
.relay-item {
  flex: 1; background: #fff; border-radius: 20rpx; padding: 24rpx 14rpx 18rpx;
  text-align: center; border: 2rpx solid #f0f0f0; transition: all 0.2s;
}
.r-on { background: #e8f5e9; border-color: rgba(45,140,63,0.2); }
.r-icon { width: 52rpx; height: 52rpx; display: block; margin: 0 auto 6rpx; }
.r-name { font-size: 26rpx; font-weight: 600; color: #333; display: block; }
.r-st { font-size: 22rpx; color: #aaa; display: block; margin: 4rpx 0 10rpx; }
.r-on .r-st { color: #2d8c3f; }

.sw {
  display: inline-block; width: 68rpx; height: 36rpx; background: #ddd;
  border-radius: 18rpx; position: relative; transition: background 0.2s;
}
.sw-on { background: #4caf50; }
.sw-dot {
  width: 30rpx; height: 30rpx; background: #fff; border-radius: 50%;
  position: absolute; top: 3rpx; left: 3rpx; transition: transform 0.2s;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.15);
}
.sw-dot-on { transform: translateX(32rpx); }

/* 快捷 */
.quick-row { display: flex; gap: 14rpx; padding: 0 22rpx; }
.q-btn {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  padding: 20rpx 6rpx; background: #fff; border-radius: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}
.q-btn text { font-size: 22rpx; color: #666; }
.q-btn:active { background: #f5f5f5; transform: scale(0.96); }
.q-icon { width: 48rpx; height: 48rpx; }

/* 视觉 */
.vis-card {
  display: flex; align-items: center; gap: 18rpx;
  margin: 0 22rpx; padding: 18rpx 20rpx;
  background: #fff; border-radius: 18rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}
.vis-img-wrap { width: 110rpx; height: 110rpx; border-radius: 14rpx; overflow: hidden; flex-shrink: 0; background: #f5f5f5; }
.vis-img { width: 100%; height: 100%; }
.vis-img-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.ph-icon { width: 60rpx; height: 60rpx; opacity: 0.4; }
.vis-info { flex: 1; }
.vis-tag { font-size: 24rpx; font-weight: 600; padding: 3rpx 14rpx; border-radius: 8rpx; display: inline-block; }
.vt-ok { background: #e8f5e9; color: #2d8c3f; }
.vt-pest { background: #fce4ec; color: #c62828; }
.vis-conf { font-size: 24rpx; color: #888; margin-top: 6rpx; display: block; }
.vis-time { font-size: 22rpx; color: #bbb; display: block; margin-top: 2rpx; }
.vis-arrow { font-size: 36rpx; color: #ddd; }

/* 节点 */
.node-row { display: flex; gap: 14rpx; padding: 0 22rpx; }
.node-item {
  display: flex; align-items: center; gap: 10rpx; padding: 14rpx 22rpx;
  background: #fff; border-radius: 14rpx; font-size: 26rpx; color: #555;
}
.nd { width: 12rpx; height: 12rpx; border-radius: 50%; background: #f44336; }
.nd-on { background: #4caf50; }
